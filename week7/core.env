# ----------------------------
# Kafka (core-инфраструктура)
# ----------------------------
# Используется в docker-compose для Kafka и Kafka UI.
# Подключается через --env-file core.env в Taskfile.

# Порты
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093
KAFKA_UI_PORT=8090

# Версии Docker-образов
KAFKA_IMAGE=confluentinc/cp-kafka:8.2.0
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# ----------------------------
# Observability (OTEL Collector, Prometheus, Grafana, Jaeger, ES, Kibana)
# ----------------------------

# Версии Docker-образов
JAEGER_IMAGE=jaegertracing/jaeger:2.6.0
PROMETHEUS_IMAGE=prom/prometheus:v3.3.1
GRAFANA_IMAGE=grafana/grafana:12.0.0
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.0.4
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.0.4
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.151.0

# Порты
OTEL_GRPC_PORT=4317
OTEL_METRICS_PORT=8888
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
