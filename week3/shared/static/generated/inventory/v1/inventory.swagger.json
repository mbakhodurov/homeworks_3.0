        },
        "price": {
          "type": "string",
          "format": "int64",
          "title": "price цена в копейках (5000₽ = 500000)"
        },
        "part_type": {
          "$ref": "#/definitions/v1PartType",
          "title": "part_type тип детали"
        },
        "stock_quantity": {
          "type": "string",
