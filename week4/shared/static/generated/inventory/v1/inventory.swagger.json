{
  "swagger": "2.0",
  "info": {
    "title": "inventory/v1/inventory.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "InventoryService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/inventories": {
      "get": {
        "summary": "GetAllPart возвращает все детали без фильтрации",
        "operationId": "InventoryService_GetAllPart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetAllPartResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/api/v1/inventory": {
      "get": {
        "summary": "ListParts возвращает список деталей с фильтрацией",
        "operationId": "InventoryService_ListParts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPartsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "filter.uuids",
            "description": "uuids список UUID для фильтрации",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "filter.part_type",
            "description": "part_type список типов деталей для фильтрации\n\n - PART_TYPE_UNSPECIFIED: PART_TYPE_UNSPECIFIED не указан\n - PART_TYPE_HULL: PART_TYPE_HULL корпус корабля\n - PART_TYPE_ENGINE: PART_TYPE_ENGINE двигатель\n - PART_TYPE_SHIELD: PART_TYPE_SHIELD защитный щит\n - PART_TYPE_WEAPON: PART_TYPE_WEAPON вооружение",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PART_TYPE_UNSPECIFIED",
                "PART_TYPE_HULL",
                "PART_TYPE_ENGINE",
                "PART_TYPE_SHIELD",
                "PART_TYPE_WEAPON"
              ]
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "InventoryService"
        ]
      },
      "post": {
        "summary": "CreateParts создаёт новую деталь",
        "operationId": "InventoryService_CreateParts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreatePartsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreatePartsRequest"
            }
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/api/v1/inventory/{uuid}": {
      "get": {
        "summary": "GetPart возвращает деталь по UUID",
        "operationId": "InventoryService_GetPart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetPartResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "uuid уникальный идентификатор детали",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "InventoryService"
        ]
      },
      "delete": {
        "summary": "DeletePart удаляет деталь по UUID",
        "operationId": "InventoryService_DeletePart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "uuid уникальный идентификатор детали",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CreatePartsRequest": {
      "type": "object",
      "properties": {
        "info": {
          "$ref": "#/definitions/v1PartInfo",
          "title": "info основная информация о детали"
        }
      },
      "title": "CreatePartsRequest запрос на создание новой детали"
    },
    "v1CreatePartsResponse": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "title": "uuid уникальный идентификатор созданной детали"
        }
      },
      "title": "CreatePartsResponse ответ на создание детали"
    },
    "v1EngineClass": {
      "type": "string",
      "enum": [
        "ENGINE_CLASS_UNSPECIFIED",
        "ENGINE_CLASS_A",
        "ENGINE_CLASS_B",
        "ENGINE_CLASS_C"
      ],
      "default": "ENGINE_CLASS_UNSPECIFIED",
      "description": "- ENGINE_CLASS_UNSPECIFIED: ENGINE_CLASS_UNSPECIFIED не указан\n - ENGINE_CLASS_A: ENGINE_CLASS_A класс A\n - ENGINE_CLASS_B: ENGINE_CLASS_B класс B\n - ENGINE_CLASS_C: ENGINE_CLASS_C класс C",
      "title": "EngineClass класс двигателя"
    },
    "v1EngineProperties": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/definitions/v1EngineClass",
          "title": "class класс двигателя"
        },
        "required_strength": {
          "type": "string",
          "format": "int64",
          "title": "required_strength минимальная прочность корпуса, необходимая для этого двигателя"
        }
      },
      "title": "EngineProperties свойства двигателя"
    },
    "v1GetAllPartResponse": {
      "type": "object",
      "properties": {
        "part": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Part"
          },
          "title": "part список деталей"
        },
        "total_count": {
          "type": "string",
          "format": "int64",
          "title": "total_count общее количество деталей"
        }
      },
      "title": "GetAllPartResponse ответ со всеми деталями"
    },
    "v1GetPartResponse": {
      "type": "object",
      "properties": {
        "part": {
          "$ref": "#/definitions/v1Part",
          "title": "part деталь космического корабля"
        }
      },
      "title": "GetPartResponse ответ на запрос получения детали"
    },
    "v1HullProperties": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "string",
          "format": "int64",
          "title": "strength прочность корпуса"
        }
      },
      "title": "HullProperties свойства корпуса"
    },
    "v1ListPartsResponse": {
      "type": "object",
      "properties": {
        "part": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Part"
          },
          "title": "part список деталей"
        },
        "total_count": {
          "type": "string",
          "format": "int64",
          "title": "total_count общее количество деталей"
        }
      },
      "title": "ListPartsResponse ответ со списком деталей"
    },
    "v1Part": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "title": "uuid уникальный идентификатор детали"
        },
        "info": {
          "$ref": "#/definitions/v1PartInfo",
          "title": "info основная информация о детали"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "created_at время создания записи"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "title": "updated_at время последнего обновления записи"
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time",
          "title": "deleted_at время удаления записи (опционально)"
        },
        "properties": {
          "$ref": "#/definitions/v1PartProperties",
          "title": "properties типоспецифичные свойства детали (опционально, зависит от part_type)"
        }
      },
      "title": "Part деталь космического корабля"
    },
    "v1PartInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name название детали"
        },
        "description": {
          "type": "string",
          "title": "description описание детали"
        },
        "price": {
          "type": "string",
          "format": "int64",
          "title": "price цена в копейках (5000₽ = 500000)"
        },
        "part_type": {
          "$ref": "#/definitions/v1PartType",
          "title": "part_type тип детали"
        },
        "stock_quantity": {
          "type": "string",
          "format": "int64",
          "title": "stock_quantity количество на складе"
        }
      },
      "title": "PartInfo основная информация о детали"
    },
    "v1PartProperties": {
      "type": "object",
      "properties": {
        "hull": {
          "$ref": "#/definitions/v1HullProperties",
          "title": "hull свойства корпуса"
        },
        "engine": {
          "$ref": "#/definitions/v1EngineProperties",
          "title": "engine свойства двигателя"
        },
        "shield": {
          "$ref": "#/definitions/v1ShieldProperties",
          "title": "shield свойства щита"
        },
        "weapon": {
          "$ref": "#/definitions/v1WeaponProperties",
          "title": "weapon свойства оружия"
        }
      },
      "description": "PartProperties типоспецифичные свойства детали. Заполнено ровно одно поле —\nто, что соответствует part_type родительской Part."
    },
    "v1PartType": {
      "type": "string",
      "enum": [
        "PART_TYPE_UNSPECIFIED",
        "PART_TYPE_HULL",
        "PART_TYPE_ENGINE",
        "PART_TYPE_SHIELD",
        "PART_TYPE_WEAPON"
      ],
      "default": "PART_TYPE_UNSPECIFIED",
      "description": "- PART_TYPE_UNSPECIFIED: PART_TYPE_UNSPECIFIED не указан\n - PART_TYPE_HULL: PART_TYPE_HULL корпус корабля\n - PART_TYPE_ENGINE: PART_TYPE_ENGINE двигатель\n - PART_TYPE_SHIELD: PART_TYPE_SHIELD защитный щит\n - PART_TYPE_WEAPON: PART_TYPE_WEAPON вооружение",
      "title": "PartType тип детали космического корабля"
    },
    "v1PartsFilter": {
      "type": "object",
      "properties": {
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "uuids список UUID для фильтрации"
        },
        "part_type": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/v1PartType"
          },
          "title": "part_type список типов деталей для фильтрации"
        }
      },
      "title": "PartsFilter фильтр для поиска деталей"
    },
    "v1ShieldProperties": {
      "type": "object",
      "properties": {
        "shield_type": {
          "$ref": "#/definitions/v1ShieldType",
          "title": "shield_type тип щита"
        }
      },
      "title": "ShieldProperties свойства щита"
    },
    "v1ShieldType": {
      "type": "string",
      "enum": [
        "SHIELD_TYPE_UNSPECIFIED",
        "SHIELD_TYPE_ENERGY",
        "SHIELD_TYPE_PLASMA"
      ],
      "default": "SHIELD_TYPE_UNSPECIFIED",
      "description": "- SHIELD_TYPE_UNSPECIFIED: SHIELD_TYPE_UNSPECIFIED не указан\n - SHIELD_TYPE_ENERGY: SHIELD_TYPE_ENERGY энергетический щит\n - SHIELD_TYPE_PLASMA: SHIELD_TYPE_PLASMA плазменный щит",
      "title": "ShieldType тип щита"
    },
    "v1WeaponProperties": {
      "type": "object",
      "properties": {
        "weapon_type": {
          "$ref": "#/definitions/v1WeaponType",
          "title": "weapon_type тип оружия"
        }
      },
      "title": "WeaponProperties свойства оружия"
    },
    "v1WeaponType": {
      "type": "string",
      "enum": [
        "WEAPON_TYPE_UNSPECIFIED",
        "WEAPON_TYPE_LASER",
        "WEAPON_TYPE_MISSILE"
      ],
      "default": "WEAPON_TYPE_UNSPECIFIED",
      "description": "- WEAPON_TYPE_UNSPECIFIED: WEAPON_TYPE_UNSPECIFIED не указан\n - WEAPON_TYPE_LASER: WEAPON_TYPE_LASER лазерное оружие\n - WEAPON_TYPE_MISSILE: WEAPON_TYPE_MISSILE ракетное оружие",
      "title": "WeaponType тип оружия"
    }
  }
}
